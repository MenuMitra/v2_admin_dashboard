# MenuMitra API Integration Patterns

## API Service Structure

### API Client Setup
```javascript
// ✅ CORRECT - Base API configuration
import axios from 'axios';
import { getToken } from '../utils/authUtils';
import { API_BASE_URL } from '../config/appConfig';

// Create axios instance with base configuration
export const apiClient = axios.create({
  baseURL: API_BASE_URL,
  timeout: 30000, // 30 seconds
  headers: {
    'Content-Type': 'application/json',
  }
});

// Request interceptor - adds auth token to every request
apiClient.interceptors.request.use(
  (config) => {
    // ✅ CORRECT - CRITICAL: Use getToken directly without adding 'Bearer'
    const token = getToken();
    if (token) {
      config.headers.Authorization = token;
    }
    return config;
  },
  (error) => Promise.reject(error)
);

// Response interceptor - handle common errors
apiClient.interceptors.response.use(
  (response) => response,
  (error) => {
    // Handle common errors (401, 403, 500, etc.)
    if (error.response?.status === 401) {
      // Handle unauthorized (redirect to login)
      window.location.href = '/login';
    }
    return Promise.reject(error);
  }
);
```

### API Service Pattern
```javascript
// ✅ CORRECT - Entity-based API service structure
export const userService = {
  // Get list with pagination and filters
  getUsers: async (page = 1, limit = 10, filters = {}) => {
    try {
      const response = await apiClient.get('/users', {
        params: { page, limit, ...filters }
      });
      return response.data;
    } catch (error) {
      throw error;
    }
  },
  
  // Get single item by ID
  getUserById: async (id) => {
    try {
      const response = await apiClient.get(`/users/${id}`);
      return response.data;
    } catch (error) {
      throw error;
    }
  },
  
  // Create new item
  createUser: async (userData) => {
    try {
      const response = await apiClient.post('/users', userData);
      return response.data;
    } catch (error) {
      throw error;
    }
  },
  
  // Update existing item
  updateUser: async (id, userData) => {
    try {
      const response = await apiClient.put(`/users/${id}`, userData);
      return response.data;
    } catch (error) {
      throw error;
    }
  },
  
  // Delete item
  deleteUser: async (id) => {
    try {
      const response = await apiClient.delete(`/users/${id}`);
      return response.data;
    } catch (error) {
      throw error;
    }
  },
  
  // Bulk actions
  bulkUpdateUsers: async (ids, data) => {
    try {
      const response = await apiClient.put('/users/bulk', { ids, data });
      return response.data;
    } catch (error) {
      throw error;
    }
  }
};
```

## React Query Integration

### Query Hooks Pattern
```javascript
// ✅ CORRECT - Query hook pattern with React Query
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { userService } from '../services/userService';
import { queryKeys } from '../lib/react-query/queryKeys';
import { toastController } from '../utils/toastController';

export function useUsers(page = 1, limit = 10, filters = {}, enabled = true) {
  return useQuery({
    queryKey: [...queryKeys.users.list(), { page, limit, filters }],
    queryFn: () => userService.getUsers(page, limit, filters),
    enabled, // Controls if query should run
    staleTime: 5 * 60 * 1000, // 5 minutes
    // ✅ CORRECT - Explicit error handling
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to fetch users');
    }
  });
}

export function useUser(id, enabled = true) {
  return useQuery({
    queryKey: queryKeys.users.detail(id),
    queryFn: () => userService.getUserById(id),
    enabled: Boolean(id) && enabled,
    staleTime: 5 * 60 * 1000, // 5 minutes
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to fetch user');
    }
  });
}

export function useCreateUser() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (userData) => userService.createUser(userData),
    // ✅ CORRECT - Invalidate and refetch after mutation
    onSuccess: () => {
      // Invalidate user list queries
      queryClient.invalidateQueries({ queryKey: queryKeys.users.list() });
      toastController.success('User created successfully');
    },
    // ✅ CORRECT - Handle errors
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to create user');
    }
  });
}

export function useUpdateUser() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: ({ id, data }) => userService.updateUser(id, data),
    onSuccess: (_, variables) => {
      // Invalidate both the list and the specific user detail
      queryClient.invalidateQueries({ queryKey: queryKeys.users.list() });
      queryClient.invalidateQueries({ queryKey: queryKeys.users.detail(variables.id) });
      toastController.success('User updated successfully');
    },
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to update user');
    }
  });
}

export function useDeleteUser() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (id) => userService.deleteUser(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.users.list() });
      toastController.success('User deleted successfully');
    },
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to delete user');
    }
  });
}

export function useBulkUpdateUsers() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: ({ ids, data }) => userService.bulkUpdateUsers(ids, data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.users.list() });
      toastController.success('Users updated successfully');
    },
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to update users');
    }
  });
}
```

## Common API Patterns

### Error Handling
```javascript
// ✅ CORRECT - Comprehensive error handling
try {
  const response = await apiClient.get('/endpoint');
  return response.data;
} catch (error) {
  // 1. Check for specific API errors first
  if (error.response) {
    const { status, data } = error.response;
    
    // Authentication errors
    if (status === 401) {
      // Handle unauthorized
      window.location.href = '/login';
      throw new Error('Session expired. Please log in again.');
    }
    
    // Authorization errors
    if (status === 403) {
      throw new Error('You do not have permission to perform this action.');
    }
    
    // Validation errors
    if (status === 422 && data.errors) {
      // Return structured validation errors
      throw { validationErrors: data.errors };
    }
    
    // Server errors
    if (status >= 500) {
      throw new Error('Server error. Please try again later.');
    }
    
    // If the API returns error messages, use them
    if (data.detail) {
      throw new Error(data.detail);
    }
  }
  
  // 2. Network/connection errors
  if (error.request) {
    throw new Error('Network error. Please check your connection.');
  }
  
  // 3. Other errors
  throw error;
}
```

### Pagination and Filtering
```javascript
// ✅ CORRECT - Pagination and filtering pattern
export function useUsers(page = 1, limit = 10, filters = {}) {
  // Memoize filters to prevent unnecessary re-renders
  const memoizedFilters = useMemo(() => filters, [
    filters.name,
    filters.email,
    filters.status,
    // Add other filter keys here
  ]);
  
  return useQuery({
    queryKey: [...queryKeys.users.list(), { page, limit, filters: memoizedFilters }],
    queryFn: () => userService.getUsers(page, limit, memoizedFilters),
    keepPreviousData: true, // Keep previous data while loading new data
  });
}

// Usage in component
function UsersTable() {
  const [page, setPage] = useState(1);
  const [limit, setLimit] = useState(50);
  const [filters, setFilters] = useState({
    name: '',
    email: '',
    status: 'all'
  });
  
  const { data, isLoading, error } = useUsers(page, limit, filters);
  
  // Reset to first page when filters change
  const handleFilterChange = (newFilters) => {
    setFilters(newFilters);
    setPage(1); // Reset to first page
  };
  
  // ...render table
}
```

### File Uploads
```javascript
// ✅ CORRECT - File upload with progress
export const fileService = {
  uploadFile: async (file, onProgress) => {
    try {
      const formData = new FormData();
      formData.append('file', file);
      
      const response = await apiClient.post('/files/upload', formData, {
        headers: {
          'Content-Type': 'multipart/form-data',
        },
        onUploadProgress: (progressEvent) => {
          const percentCompleted = Math.round(
            (progressEvent.loaded * 100) / progressEvent.total
          );
          if (onProgress) onProgress(percentCompleted);
        },
      });
      
      return response.data;
    } catch (error) {
      throw error;
    }
  }
};

// Usage in component with React Query
export function useFileUpload() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: ({ file, onProgress }) => fileService.uploadFile(file, onProgress),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.files.list() });
      toastController.success('File uploaded successfully');
    },
    onError: (error) => {
      toastController.error(error.response?.data?.detail || 'Failed to upload file');
    }
  });
}
```

