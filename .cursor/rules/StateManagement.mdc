# MenuMitra State Management Patterns

## Core Principles

### State Management Types
- **Server State**: Use React Query for all server data
- **UI State**: Use local component state or context for UI elements
- **Application State**: Use context for cross-component state

### React Query for Server State
```javascript
// ✅ CORRECT - Server state management with React Query
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { queryKeys } from '../lib/react-query/queryKeys';
import { entityService } from '../services/entityService';

// 1. Queries for fetching data
export function useEntityList(params) {
  return useQuery({
    queryKey: [...queryKeys.entity.list(), params],
    queryFn: () => entityService.getList(params),
    staleTime: 5 * 60 * 1000, // 5 minutes
  });
}

// 2. Mutations for creating/updating/deleting
export function useCreateEntity() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (data) => entityService.create(data),
    onSuccess: () => {
      // Invalidate queries
      queryClient.invalidateQueries({ queryKey: queryKeys.entity.list() });
      // Optionally, directly update cache
      // queryClient.setQueryData(...);
    }
  });
}
```

### React Context for Global UI State
```javascript
// ✅ CORRECT - Global UI state with Context API
// 1. Create context
import React, { createContext, useContext, useReducer } from 'react';

// Define initial state
const initialState = {
  theme: 'light',
  sidebarCollapsed: false,
  notifications: []
};

// Create context
const UIContext = createContext();

// Create reducer
function uiReducer(state, action) {
  switch (action.type) {
    case 'TOGGLE_THEME':
      return {
        ...state,
        theme: state.theme === 'light' ? 'dark' : 'light'
      };
    case 'TOGGLE_SIDEBAR':
      return {
        ...state,
        sidebarCollapsed: !state.sidebarCollapsed
      };
    case 'ADD_NOTIFICATION':
      return {
        ...state,
        notifications: [...state.notifications, action.payload]
      };
    case 'REMOVE_NOTIFICATION':
      return {
        ...state,
        notifications: state.notifications.filter(n => n.id !== action.payload)
      };
    default:
      return state;
  }
}

// 2. Create provider
export function UIProvider({ children }) {
  const [state, dispatch] = useReducer(uiReducer, initialState);
  
  return (
    <UIContext.Provider value={{ state, dispatch }}>
      {children}
    </UIContext.Provider>
  );
}

// 3. Create custom hook
export function useUI() {
  const context = useContext(UIContext);
  if (!context) {
    throw new Error('useUI must be used within a UIProvider');
  }
  
  // Helper functions for common actions
  const toggleTheme = () => context.dispatch({ type: 'TOGGLE_THEME' });
  const toggleSidebar = () => context.dispatch({ type: 'TOGGLE_SIDEBAR' });
  const addNotification = (notification) => {
    context.dispatch({
      type: 'ADD_NOTIFICATION',
      payload: {
        id: Date.now(),
        ...notification
      }
    });
  };
  const removeNotification = (id) => {
    context.dispatch({
      type: 'REMOVE_NOTIFICATION',
      payload: id
    });
  };
  
  return {
    ...context.state,
    toggleTheme,
    toggleSidebar,
    addNotification,
    removeNotification
  };
}
```

### Local Component State
```jsx
// ✅ CORRECT - Local component state for UI elements
function FormComponent() {
  // Group related state
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    phone: ''
  });
  
  // Separate UI state
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errors, setErrors] = useState({});
  
  // Handle form changes
  const handleChange = (e) => {
    const { name, value } = e.target;
    
    // Update form data
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
    
    // Clear errors when field is edited
    if (errors[name]) {
      setErrors(prev => ({
        ...prev,
        [name]: null
      }));
    }
  };
  
  // Form submission
  const handleSubmit = async (e) => {
    e.preventDefault();
    setIsSubmitting(true);
    
    try {
      // Form processing
      await submitForm(formData);
      // Reset form after success
      setFormData({
        name: '',
        email: '',
        phone: ''
      });
    } catch (error) {
      // Handle validation errors
      if (error.validationErrors) {
        setErrors(error.validationErrors);
      }
    } finally {
      setIsSubmitting(false);
    }
  };
  
  return (
    <form onSubmit={handleSubmit}>
      {/* Form fields */}
    </form>
  );
}
```

## Advanced State Patterns

### Derived State
```jsx
// ✅ CORRECT - Derive state from props or other state
function DataDisplay({ data }) {
  // ✅ CORRECT - Use useMemo for derived state
  const processedData = useMemo(() => {
    if (!data) return [];
    
    return data.map(item => ({
      ...item,
      formattedDate: new Date(item.date).toLocaleDateString(),
      statusText: item.status === 1 ? 'Active' : 'Inactive',
      // Add more derived fields
    }));
  }, [data]);
  
  // ✅ CORRECT - Calculate totals from data
  const totals = useMemo(() => {
    if (!data) return { count: 0, active: 0 };
    
    return data.reduce((acc, item) => ({
      count: acc.count + 1,
      active: acc.active + (item.status === 1 ? 1 : 0)
    }), { count: 0, active: 0 });
  }, [data]);
  
  return (
    <div>
      <h2>Data Summary</h2>
      <p>Total: {totals.count}, Active: {totals.active}</p>
      
      <DataTable data={processedData} />
    </div>
  );
}
```

### State Synchronization
```jsx
// ✅ CORRECT - Synchronize state with URL parameters
import { useSearchParams } from 'react-router-dom';

function FilterableList() {
  // URL parameters as source of truth
  const [searchParams, setSearchParams] = useSearchParams();
  
  // Local state derived from URL
  const [filters, setFilters] = useState({
    search: searchParams.get('search') || '',
    status: searchParams.get('status') || 'all',
    page: parseInt(searchParams.get('page') || '1', 10)
  });
  
  // Update URL when filters change
  const updateFilters = (newFilters) => {
    const updatedFilters = { ...filters, ...newFilters };
    setFilters(updatedFilters);
    
    // Update URL params
    const params = new URLSearchParams();
    if (updatedFilters.search) params.set('search', updatedFilters.search);
    if (updatedFilters.status !== 'all') params.set('status', updatedFilters.status);
    if (updatedFilters.page > 1) params.set('page', updatedFilters.page.toString());
    
    setSearchParams(params);
  };
  
  // React Query with filters
  const { data, isLoading } = useEntityList(filters);
  
  return (
    <div>
      <FilterForm 
        filters={filters} 
        onChange={(newFilters) => updateFilters({ ...newFilters, page: 1 })} 
      />
      
      <DataTable data={data} />
      
      <Pagination 
        currentPage={filters.page} 
        totalPages={data?.totalPages || 1}
        onPageChange={(page) => updateFilters({ page })}
      />
    </div>
  );
}
```

### Form State Management
```jsx
// ✅ CORRECT - Form state with validation
function EntityForm({ initialData = {}, onSubmit }) {
  // Form state
  const [formData, setFormData] = useState({
    name: initialData.name || '',
    description: initialData.description || '',
    status: initialData.status || 'active',
    // More fields
  });
  
  // Validation state
  const [errors, setErrors] = useState({});
  const [touched, setTouched] = useState({});
  
  // Handle field change
  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setFormData(prev => ({
      ...prev,
      // Handle different input types
      [name]: type === 'checkbox' ? checked : value
    }));
    
    // Mark field as touched
    if (!touched[name]) {
      setTouched(prev => ({ ...prev, [name]: true }));
    }
    
    // Clear error when field changes
    if (errors[name]) {
      setErrors(prev => ({ ...prev, [name]: null }));
    }
  };
  
  // Validate form
  const validate = () => {
    const newErrors = {};
    
    // Required fields
    if (!formData.name.trim()) {
      newErrors.name = 'Name is required';
    } else if (formData.name.length < 3) {
      newErrors.name = 'Name must be at least 3 characters';
    }
    
    // More validations...
    
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };
  
  // Handle form submission
  const handleSubmit = (e) => {
    e.preventDefault();
    
    // Mark all fields as touched
    const allTouched = Object.keys(formData).reduce((acc, key) => {
      acc[key] = true;
      return acc;
    }, {});
    setTouched(allTouched);
    
    // Validate and submit
    if (validate()) {
      onSubmit(formData);
    }
  };
  
  return (
    <form onSubmit={handleSubmit}>
      <div className="form-group">
        <label htmlFor="name">Name</label>
        <input
          id="name"
          name="name"
          value={formData.name}
          onChange={handleChange}
          className={errors.name && touched.name ? 'input-error' : ''}
        />
        {errors.name && touched.name && (
          <div className="error">{errors.name}</div>
        )}
      </div>
      
      {/* More form fields */}
      
      <button type="submit">Submit</button>
    </form>
  );
}
```

## Performance Optimization

### Memoization and Callbacks
```jsx
// ✅ CORRECT - Prevent unnecessary re-renders with memo
const MemoizedComponent = React.memo(function Component(props) {
  // Component logic
});

function ParentComponent() {
  // ✅ CORRECT - Memoize callbacks
  const handleClick = useCallback(() => {
    // Handle click
  }, [/* dependencies */]);
  
  // ✅ CORRECT - Memoize expensive calculations
  const processedData = useMemo(() => {
    return expensiveOperation(data);
  }, [data]);
  
  return (
    <MemoizedComponent 
      data={processedData} 
      onClick={handleClick}
    />
  );
}
```

### State Updates Best Practices
```jsx
// ✅ CORRECT - Batch related state updates
function UserActions() {
  const [isLoading, setIsLoading] = useState(false);
  const [data, setData] = useState(null);
  const [error, setError] = useState(null);
  
  const fetchUserData = async () => {
    // Reset states at the beginning
    setIsLoading(true);
    setError(null);
    
    try {
      const result = await fetchData();
      setData(result);
    } catch (err) {
      setError(err.message);
    } finally {
      setIsLoading(false);
    }
  };
  
  // ✅ CORRECT - Use functional updates for state that depends on previous state
  const incrementCounter = () => {
    setCounter(prevCount => prevCount + 1);
  };
  
  // ✅ CORRECT - Update objects and arrays immutably
  const updateUserProperty = (id, property, value) => {
    setUsers(prevUsers => 
      prevUsers.map(user => 
        user.id === id ? { ...user, [property]: value } : user
      )
    );
  };
}
```

