# MenuMitra Component Patterns

## Component Structure

### Standard Component Template
```jsx
import React, { useState, useEffect } from "react";
import PropTypes from "prop-types";

// Component imports - alphabetical order
import ComponentA from "./ComponentA";
import ComponentB from "./ComponentB";

// Hook imports - ordered by importance
import { useData } from "../../hooks/useData";

// Utility imports
import { formatUtils } from "../../utils/formatUtils";

/**
 * Component description - what it does and when to use it
 */
function MyComponent({ prop1, prop2, prop3 }) {
  // State declarations - grouped by related functionality
  const [loading, setLoading] = useState(false);
  const [data, setData] = useState(null);
  
  // Hooks - ordered by execution importance
  const { mutate, isLoading } = useData();
  
  // Effects - clearly commented purpose
  useEffect(() => {
    // Clear description of what this effect does
    // ...
  }, [dependency1, dependency2]);
  
  // Event handlers - descriptive names
  const handleSubmit = () => {
    // ...
  };
  
  // Rendering helpers - extract complex JSX
  const renderItems = () => {
    return data.map((item) => (
      <div key={item.id}>
        {item.name}
      </div>
    ));
  };
  
  // Conditional rendering
  if (loading) {
    return <LoadingSpinner />;
  }
  
  // Main render
  return (
    <div className="component-container">
      {/* Group related elements with comments */}
      <header>
        <h1>{title}</h1>
      </header>
      
      <main>
        {data && renderItems()}
      </main>
      
      <footer>
        <button onClick={handleSubmit}>Submit</button>
      </footer>
    </div>
  );
}

// PropTypes - always define for component API clarity
MyComponent.propTypes = {
  prop1: PropTypes.string.isRequired,
  prop2: PropTypes.number,
  prop3: PropTypes.func,
};

// Default props - set sensible defaults
MyComponent.defaultProps = {
  prop2: 0,
  prop3: () => {},
};

export default MyComponent;
```

## Advanced Component Patterns

### Container/Presentational Pattern
```jsx
// ✅ CORRECT - Container component handles data/logic
function UserContainer() {
  const { data, isLoading } = useUser();
  
  if (isLoading) {
    return <LoadingSpinner />;
  }
  
  return <UserPresentation user={data} />;
}

// ✅ CORRECT - Presentation component is pure rendering
function UserPresentation({ user }) {
  return (
    <div className="user-card">
      <h3>{user.name}</h3>
      <p>{user.email}</p>
    </div>
  );
}
```

### Component Composition
```jsx
// ✅ CORRECT - Use composition for flexible components
function Card({ header, content, footer }) {
  return (
    <div className="card">
      {header && <div className="card-header">{header}</div>}
      <div className="card-body">{content}</div>
      {footer && <div className="card-footer">{footer}</div>}
    </div>
  );
}

// Usage
<Card
  header={<h2>User Profile</h2>}
  content={<UserDetails user={user} />}
  footer={<UserActions user={user} />}
/>
```

## Performance Optimization

### Memoization
```jsx
// ✅ CORRECT - Use React.memo for pure components
const MemoizedComponent = React.memo(function MemoizedComponent({ value }) {
  return <div>{value}</div>;
});

// ✅ CORRECT - Use useMemo for expensive calculations
const expensiveValue = useMemo(() => {
  return computeExpensiveValue(a, b);
}, [a, b]);

// ✅ CORRECT - Use useCallback for functions passed to child components
const handleClick = useCallback(() => {
  console.log('Clicked!', id);
}, [id]);
```

## Form Handling

### Form Component Pattern
```jsx
// ✅ CORRECT - Form components with validation
function UserForm({ onSubmit, initialData }) {
  const [formData, setFormData] = useState(initialData);
  const [errors, setErrors] = useState({});
  
  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    
    // Clear error when field is edited
    if (errors[name]) {
      setErrors(prev => ({ ...prev, [name]: null }));
    }
  };
  
  const validate = () => {
    const newErrors = {};
    // Validation logic
    // ...
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };
  
  const handleSubmit = (e) => {
    e.preventDefault();
    if (validate()) {
      onSubmit(formData);
    }
  };
  
  return (
    <form onSubmit={handleSubmit}>
      {/* Form fields */}
    </form>
  );
}
```

## DataTable Integration

### DataTable Implementation
```jsx
// ✅ CORRECT - DataTable with proper props
<DataTable
  data={userData}
  columns={[
    { 
      field: "name", 
