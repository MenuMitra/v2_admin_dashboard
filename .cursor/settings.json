{
  "editor": {
    "formatOnSave": true,
    "tabSize": 2,
    "insertSpaces": true,
    "defaultFormatter": "prettier"
  },
  "files": {
    "exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.git": true
    },
    "associations": {
      "*.jsx": "javascriptreact",
      "*.tsx": "typescriptreact"
    }
  },
  "javascript": {
    "suggest.autoImports": true,
    "preferences.quoteStyle": "single",
    "updateImportsOnFileMove.enabled": "always"
  },
  "typescript": {
    "suggest.autoImports": true,
    "preferences.quoteStyle": "single",
    "updateImportsOnFileMove.enabled": "always"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "printWidth": 100
  },
  "eslint": {
    "enable": true,
    "run": "onSave"
  },
  "tailwindCSS": {
    "emmetCompletions": true,
    "validate": true
  },
  "git": {
    "autofetch": true,
    "confirmSync": true,
    "enableSmartCommit": true
  }
} 